# === BINANCE API (SPOT - SEM SAQUE) ===
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
# Para DEMO, use Binance Testnet:
# https://testnet.binance.vision/
BINANCE_TESTNET=true

# === BLOCKCHAIN - ARBITRUM ===
ARBITRUM_RPC=https://arb-mainnet.g.alchemy.com/v2/your_key
# Ou Infura: https://arbitrum-mainnet.infura.io/v3/your_key
PRIVATE_KEY=your_wallet_private_key_for_onchain_audit
JEV_CONTRACT=0x... # Endereço do JEVJournal.sol deployado na Arbitrum

# === BACKEND ===
PORT=8000
INITIAL_BALANCE=100
POPULATION_SIZE=12
SYMBOL=BTC/USDT

# === FRONTEND ===
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_ARBISCAN=https://arbiscan.io/address/
