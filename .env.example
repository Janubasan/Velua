# Flow Engine — configuração da LLM (opcional)
# Sem LLM_API_KEY o sistema roda no motor local determinístico.

# openai | groq | anthropic
LLM_PROVIDER=openai

# Chave da API (obrigatória para modo LLM)
LLM_API_KEY=

# Modelo (padrão: gpt-4o-mini / llama-3.3-70b-versatile / claude-sonnet-4-20250514)
LLM_MODEL=

# Endpoint customizado (Groq, Together, OpenRouter, Ollama...)
# LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_BASE_URL=
